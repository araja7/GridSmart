# Elecz zone code (no API key required). See https://elecz.com/docs
# Examples: US-CA-SP15, US-TX-HB_HOUSTON, DE, GB, US-NY-NYC
ELECZ_ZONE=US-CA-SP15

# Minimum parsed hours for full live (default 20) or partial (default 4)
# ELECZ_MIN_FULL_HOURS=20
# ELECZ_MIN_PARTIAL_HOURS=4

# Refuse scheduling when only CSV fallback is available
# ELECZ_STRICT=true
